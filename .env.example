# ===== Supabase (مطلوب) =====
# من لوحة Supabase: Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxx

# ===== البحث بالذكاء الاصطناعي (اختياري) =====
