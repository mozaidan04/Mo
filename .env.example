ANTHROPIC_API_KEY=

# مطلوب فقط إن كان المفتاح مرتبطًا بهوية (identity-linked):
# معرّف مساحة العمل من console.anthropic.com ويبدأ بـ wrkspc_
ANTHROPIC_WORKSPACE_ID=
