# كلمة مرور لوحة التحكم (صفحة /admin) — غيّرها قبل النشر
ADMIN_PASSWORD=change-me

# سر توقيع جلسة لوحة التحكم (أي نص عشوائي طويل)
ADMIN_SESSION_SECRET=please-change-this-to-a-long-random-string

# مفتاح Claude لتفعيل البحث بالذكاء الاصطناعي.
# بدون هذا المفتاح يعمل البحث بالمطابقة النصية فقط.
ANTHROPIC_API_KEY=

